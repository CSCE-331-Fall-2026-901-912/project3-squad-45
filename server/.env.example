DB_HOST=csce-315-db.engr.tamu.edu
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
PORT=3001

# Optional: comma-separated browser origins allowed to call the API in dev
CORS_ORIGINS=http://localhost:5173

# Google sign-in. Leave GOOGLE_CLIENT_ID empty to disable auth in local dev.
GOOGLE_CLIENT_ID=
SESSION_SECRET=change-me
MANAGER_EMAILS=reveille.bubbletea@gmail.com

# Sprint 2 external APIs. Each feature degrades gracefully when its key is empty.
# Machine translation (Google Cloud Translation API, v2 key)
GOOGLE_TRANSLATE_API_KEY=
# Menu assistant (Anthropic Claude). ANTHROPIC_MODEL is optional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Weather uses Open-Meteo, which needs no key.
